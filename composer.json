{
	"description": "CodeIgniter 3 starter — PHP 8.4+, HMVC, DevelBar",
	"name": "godzam/codeigniter3-new",
	"type": "project",
	"homepage": "https://github.com/godzam/codeigniter3-new",
	"license": "MIT",
	"require": {
		"php": ">=8.1",
		"vlucas/phpdotenv": "^5.6",
		"monolog/monolog": "^3.7"
	},
	"require-dev": {
		"mikey179/vfsstream": "1.6.*",
		"phpunit/phpunit": "^10.5",
		"phpstan/phpstan": "^2.1",
		"friendsofphp/php-cs-fixer": "^3.64",
		"guzzlehttp/guzzle": "^7.9"
	},
	"autoload": {
		"psr-4": {
			"App\\": "application/src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AppTests\\": "tests-app/"
		}
	},
	"scripts": {
		"serve": "php -S localhost:8000",
		"analyze": "phpstan analyse",
		"cs-check": "php-cs-fixer fix --dry-run --diff",
		"cs-fix": "php-cs-fixer fix",
		"test": "phpunit --configuration tests-app/phpunit.xml"
	}
}
