# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.
#
# Nothing in this app requires .env to exist: every value here has a
# hardcoded fallback in its respective config file.

# development | testing | production
CI_ENV=development

# The one-click installer (/install) is only available in development and testing.
# To use it on a production server for the first install, set this to true, then remove it.
# INSTALLER_ENABLED=false

DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=your_database_name
DB_DRIVER=mysqli

# Editor that file links on the development error page open in:
# vscode | phpstorm | sublime | cursor | ... (see application/config/errors.php)
ERROR_EDITOR=vscode

# Cloudflare Turnstile. Defaults for Settings -> Security; a value saved there wins.
# Turnstile is on by default: protection starts as soon as both keys are set, and
# stays inert (no widget, no Cloudflare call) while one is missing. Dummy keys for
# local testing: see the README ("Cloudflare Turnstile").
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Big data & several servers (all optional; see README "Big data & several servers") ---

# Behind a load balancer/CDN: its address(es), comma separated. Needed for correct client IPs.
# TRUSTED_PROXIES=10.0.0.0/8

# Sessions: files | database | redis        Cache: file | redis | memcached
# SESS_DRIVER=files
# CACHE_DRIVER=file
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logs: LOG_CHANNEL=stderr for containers; LOG_THRESHOLD 0 off, 1 errors, 2 debug, 3 info, 4 all
# LOG_CHANNEL=file
# LOG_THRESHOLD=1

# Lists count at most this many rows ("100,000+")
# DATATABLE_COUNT_CAP=100000

# Export limits (rows per file) and time limit (seconds)
# EXPORT_MAX_ROWS_CSV=1000000
# EXPORT_MAX_ROWS_XLSX=250000
# EXPORT_MAX_ROWS_PDF=2000
# EXPORT_TIME_LIMIT=300
